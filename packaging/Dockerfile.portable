FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip python3-tk build-essential \
    wmctrl x11-utils xclip scrot xvfb xauth ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir \
    pyinstaller==6.11.1 Pillow==10.4.0 pyperclip==1.9.0 \
    pyautogui==0.9.54 pynput==1.7.7 evdev==1.7.1
WORKDIR /app
COPY . /app
RUN xvfb-run -a env XDG_SESSION_TYPE=x11 python3 -m PyInstaller \
    --noconfirm --onefile --name TopDock-VDI \
    --distpath dist-linux --workpath build-linux --specpath build-linux \
    --hidden-import pynput.keyboard._xorg --hidden-import pynput.mouse._xorg \
    --exclude-module PyQt5 --exclude-module numpy --exclude-module cv2 \
    --add-binary /usr/bin/wmctrl:bin --add-binary /usr/bin/xprop:bin \
    --add-binary /usr/bin/xclip:bin --add-binary /usr/bin/scrot:bin \
    --add-binary /usr/lib/x86_64-linux-gnu/imlib2/loaders/png.so:imlib2/loaders \
    linux_topdock.py
RUN xvfb-run -a env XDG_SESSION_TYPE=x11 dist-linux/TopDock-VDI --check \
    && xvfb-run -a -s '-screen 0 3840x2160x24' env XDG_SESSION_TYPE=x11 dist-linux/TopDock-VDI --portable-test \
    && xvfb-run -a env XDG_SESSION_TYPE=x11 python3 tests/linux_binary_smoke.py
CMD ["cp", "/app/dist-linux/TopDock-VDI", "/out/TopDock-Linux-x86_64"]
