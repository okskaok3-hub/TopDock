<Window x:Class="TopDock.AreaSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select auto-click area" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" Cursor="Cross" WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Canvas x:Name="SelectionCanvas" Background="#B20A0C11"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                MouseRightButtonDown="Canvas_MouseRightButtonDown">
            <Border x:Name="SelectionBorder" Visibility="Collapsed"
                    Background="#308B5CF6" BorderBrush="#FFB79CFF"
                    BorderThickness="2" CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
                Background="#F21A1D25" BorderBrush="#38FFFFFF" BorderThickness="1"
                CornerRadius="16" Padding="20,12" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="Select auto-click area" Foreground="White" FontSize="16"
                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Drag a rectangle • Release to save • Esc or right-click to cancel"
                           Foreground="#AAB8C1D1" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
